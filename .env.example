# ─────────────────────────────────────────────────────────────
# Reserva API — environment configuration
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (frontends)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Database (Postgres)
DATABASE_URL=postgresql://reserva:reserva@localhost:5432/reserva?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Shared secret the internal-backoffice uses to provision partners (x-internal-key header)
INTERNAL_API_KEY=change-me-internal-key-min-16-chars

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:abrahamyan.hayk.03@gmail.com

# Transactional email (Gmail SMTP). SMTP_PASS is a Gmail App Password
# (Google account -> Security -> 2-Step -> App passwords), NOT your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=abrahamyan.hayk.03@gmail.com
SMTP_PASS=
MAIL_FROM=Reserva <abrahamyan.hayk.03@gmail.com>

# Backoffice URL for the signup activation magic link
BACKOFFICE_URL=https://backoffice.reserva.am

# Throttling (requests per window)
THROTTLE_TTL=60
THROTTLE_LIMIT=120
