// ─────────────────────────────────────────────────────────────
// Reserva — multi-tenant salon booking platform
// Postgres schema. Tenancy: every owned row carries partnerId.
// IDs are app-generated UUIDv7 (time-ordered, index-friendly).
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum UserRole {
  admin
  manager
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  noshow
}

/// How a booking entered the system — useful for analytics + audit.
enum BookingSource {
  public // client booked themselves via /p/:slug
  backoffice // created by an admin/manager
}

enum OtpChannel {
  phone
  email
}

enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

/// Whether the tenant is a multi-person salon or a solo professional. Drives
/// presentation only (a `single` has one hidden location + specialist under the
/// hood); the booking engine is identical for both.
enum PartnerKind {
  salon
  single
}

// ── Partner (tenant) ────────────────────────────────────────

model Partner {
  id   String @id
  /// Public URL handle: slug.reserva.am / reserva.am/p/:slug. Optional — a
  /// partner can be created without one (then the public page 404s until the
  /// owner sets a slug in Settings). Unique when present (Postgres allows
  /// multiple NULLs under a unique index).
  slug String? @unique
  name String
  /// Free-text category shown publicly, e.g. "Aesthetic clinic".
  type String

  /// salon (default) or single (solo professional). Presentation-only flag.
  kind PartnerKind @default(salon)

  // Branding
  accent String // primary brand color (hex)

  /// When false (default), public bookings land as `pending` and staff must
  /// confirm them manually. When true, public bookings are auto-confirmed.
  autoConfirmBookings Boolean @default(false)

  /// When true (default), the public page (/p/:slug) shows booking CTAs and the
  /// booking flow works. When false, the salon is "contact-only": all booking
  /// CTAs are hidden/replaced with call/contact actions and the public booking
  /// endpoints reject. Togglable by the partner (Settings) and platform staff.
  bookingsEnabled Boolean @default(true)

  /// Whether this salon is featured in the public Reserva marketplace (/salons).
  /// Curated: only togglable from the internal-backoffice (platform staff). The
  /// partner sees it read-only. Default off — salons opt in via the platform.
  marketplaceListed Boolean @default(false)

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  presentation PartnerPresentation?
  locations    Location[]
  services     Service[]
  specialists  Specialist[]
  bookings     Booking[]
  clients      Client[]
  users        User[]

  @@index([active])
  // Marketplace listing query: active, listed salons.
  @@index([marketplaceListed, active])
  @@map("partners")
}

/// Public-facing marketing fields for the branded booking page. Split from
/// Partner so the hot tenant row stays lean and these rarely-changing,
/// publicly-served fields can be cached/served independently.
model PartnerPresentation {
  partnerId String  @id
  tagline   String  @default("")
  about     String  @default("")
  /// Optional brand logo URL. Shown instead of the name initial where set.
  logoUrl   String  @default("")
  hours     String  @default("") // human-readable summary, e.g. "Mon–Sat · 10:00–19:00"
  /// Public social links (full URLs). Empty = not shown on the booking page.
  instagram String  @default("")
  facebook  String  @default("")
  /// WhatsApp number in international digits (e.g. "37491234567"), used to build
  /// a wa.me click-to-chat link on the public page. Empty = not shown.
  whatsapp  String  @default("")
  rating    Decimal @default(0) @db.Decimal(2, 1)
  reviews   Int     @default(0)
  /// Hero gradient tints [from, to] + decorative gallery tiles, stored as JSON
  /// since they're presentation-only and read as a blob.
  heroTints Json    @default("[]")
  /// "Inside" gallery — simple photos of the place. JSON array of tiles.
  gallery   Json    @default("[]")
  /// "Works" — photos of the work done; tiles may be simple or before/after.
  works     Json    @default("[]")

  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_presentations")
}

// ── Location (branch) ───────────────────────────────────────

model Location {
  id        String @id
  partnerId String
  name      String
  address   String
  phone     String @default("")

  /// Geo coordinates from the map picker (null until set). Powers map display,
  /// directions, and future "near me" / distance sort on the marketplace.
  lat       Float?
  lng       Float?

  /// Weekly opening hours: { mon: { enabled, start, end }, ... }. JSON because
  /// it's always read/written as a whole and never queried by inner fields.
  hours Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partner     Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  specialists Specialist[]
  bookings    Booking[]
  users       User[]

  @@index([partnerId, deletedAt])
  @@map("locations")
}

// ── Service ─────────────────────────────────────────────────

model Service {
  id        String  @id
  partnerId String
  name      String
  category  String  @default("")
  /// Stored in the smallest currency unit (AMD has no minor unit → whole drams).
  price     Int
  /// Duration in minutes.
  duration  Int
  /// How often this service should be repeated, in TOTAL DAYS (e.g. 40 = "1
  /// month & 10 days"). Null = no recurrence. Foundation for future "time to
  /// rebook" reminders. Backoffice-only; never shown on the public page.
  repeatEveryDays Int?

  /// When false, this is a "facility"/entry service (spa sauna, pool, day pass)
  /// that isn't tied to a person — availability comes from location hours and
  /// `capacity` concurrent guests, and booking skips specialist selection.
  requiresSpecialist Boolean @default(true)
  /// Max concurrent bookings per time slot for a no-specialist service. Ignored
  /// when requiresSpecialist = true.
  capacity Int @default(1)

  active    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partner          Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  specialistLinks  SpecialistService[]
  bookings         Booking[]

  @@index([partnerId, deletedAt])
  @@index([partnerId, active])
  @@map("services")
}

// ── Specialist ──────────────────────────────────────────────

model Specialist {
  id         String  @id
  partnerId  String
  locationId String
  name       String
  title      String  @default("")
  phone      String  @default("")
  active     Boolean @default(true)

  /// Recurring weekly schedule: { mon: { enabled, start, end }, ... }.
  schedule Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partner   Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  location  Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  services  SpecialistService[]
  timeOff   SpecialistTimeOff[]
  bookings  Booking[]
  reviews   SpecialistReview[]

  @@index([partnerId, deletedAt])
  @@index([locationId, active])
  @@map("specialists")
}

/// Public review left for a specialist on the booking page. No auth — the
/// reviewer optionally gives a name (else shown as "Anonymous"); stars are
/// required, text is optional. Published instantly; partners delete unwanted
/// ones from the backoffice. Ratings shown in the client app are computed
/// averages of these rows (never fabricated).
model SpecialistReview {
  id           String   @id
  specialistId String
  partnerId    String // denormalized for fast tenant-scoped queries
  /// Reviewer's display name; empty → rendered as "Anonymous".
  author       String   @default("")
  /// 1–5 stars (enforced in the DTO).
  rating       Int
  /// Optional free-text comment.
  text         String   @default("")

  createdAt DateTime @default(now())

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([specialistId, createdAt])
  @@index([partnerId, createdAt])
  @@map("specialist_reviews")
}

/// Join table: which services a specialist can perform (many-to-many).
model SpecialistService {
  specialistId String
  serviceId    String

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([specialistId, serviceId])
  @@index([serviceId])
  @@map("specialist_services")
}

/// One-off, dated unavailability that overrides the weekly schedule.
model SpecialistTimeOff {
  id           String   @id
  specialistId String
  partnerId    String // denormalized for fast tenant-scoped queries
  startAt      DateTime
  endAt        DateTime
  allDay       Boolean  @default(false)
  reason       String?
  createdById  String?

  createdAt DateTime @default(now())

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([specialistId, startAt, endAt])
  @@index([partnerId, startAt])
  @@map("specialist_time_off")
}

// ── Client ──────────────────────────────────────────────────

/// A customer of a partner. No client-facing auth — created/updated implicitly
/// when a booking is made (deduped per partner on normalized phone). Powers the
/// backoffice Clients page.
model Client {
  id        String  @id
  partnerId String
  name      String
  /// Normalized (digits-only) phone — the per-partner identity key.
  phone     String
  email     String?
  notes     String?

  /// Telegram chat id, set once the customer connects via @ReservaBookingBot
  /// (deep-link /start flow). When present, booking notifications are delivered
  /// to them for free over Telegram. Null = not connected.
  telegramChatId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner       Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  telegramLinks TelegramLink[]

  @@unique([partnerId, phone])
  @@index([partnerId, name])
  @@map("clients")
}

/// Short-lived, single-use token that binds a Telegram chat to a Client. Created
/// when we show the "Get notified" button after a booking; consumed when the
/// customer presses Start on the bot (the token rides in the /start payload).
model TelegramLink {
  /// The opaque token embedded in the t.me/<bot>?start=<token> deep link.
  token     String   @id
  clientId  String
  /// The booking this link was generated from (for the welcome message context).
  bookingId String?
  expiresAt DateTime
  /// Set when the customer completes the /start bind — makes the token single-use.
  consumedAt DateTime?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
  @@map("telegram_links")
}

// ── Booking ─────────────────────────────────────────────────

model Booking {
  id           String        @id
  partnerId    String
  locationId   String
  /// Null for facility/entry services that aren't tied to a person (spa).
  specialistId String?
  serviceId    String
  clientId     String

  /// Snapshot of client contact at time of booking (client row may change).
  clientName  String
  clientPhone String

  startAt DateTime
  endAt   DateTime
  status  BookingStatus @default(confirmed)
  source  BookingSource @default(backoffice)
  notes   String?

  /// UI language the customer booked in ('en' | 'hy' | 'ru'). Used to localize
  /// reminder/confirmation messages later. Null for older/backoffice bookings.
  locale  String?

  /// Price captured at booking time (service price may change later).
  priceAtBooking Int @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner    Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  specialist Specialist? @relation(fields: [specialistId], references: [id], onDelete: Restrict)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  pushSubscriptions ClientPushSubscription[]

  // Calendar/list queries are almost always tenant + time-window scoped.
  @@index([partnerId, startAt])
  @@index([locationId, startAt])
  @@index([specialistId, startAt])
  @@index([clientId, startAt])
  @@index([partnerId, status, startAt])
  @@map("bookings")
}

// ── User (backoffice staff) ─────────────────────────────────

model User {
  id        String   @id
  partnerId String
  name      String
  email     String
  phone     String
  role      UserRole @default(manager)
  /// Managers are scoped to a single branch; admins have null (all locations).
  locationId String?

  passwordHash String
  /// Force a password change after first login (managers created with an OTP).
  mustChangePassword Boolean     @default(false)
  otpChannel         OtpChannel?

  active    Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partner           Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  // Login is by email OR phone, globally unique so the right tenant is found.
  @@unique([email])
  @@unique([phone])
  @@index([partnerId, role])
  @@map("users")
}

/// Booking-related event types that produce notifications.
enum NotificationType {
  booking_created
  booking_rescheduled
  booking_cancelled
  booking_confirmed
  booking_completed
  booking_noshow
}

/// In-app notification feed — ONE row per recipient user (so read/unread is
/// per-user without a join). Low-volume + prunable. `data` carries render +
/// deep-link info (clientName, service, time, bookingId).
model Notification {
  id        String           @id
  userId    String
  partnerId String
  type      NotificationType
  title     String
  body      String
  /// Structured payload for the UI: { bookingId, clientName, service, ... }.
  data      Json             @default("{}")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "my unread feed, newest first" is the hot query.
  @@index([userId, read, createdAt])
  @@map("notifications")
}

/// Web Push subscriptions (one user may have several — phone, laptop, …). Used
/// to deliver booking notifications to logged-in backoffice staff.
model PushSubscription {
  id        String   @id
  userId    String
  /// Push service endpoint URL (unique per browser/device subscription).
  endpoint  String   @unique
  /// Encryption keys from the browser PushSubscription (for payload encryption).
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Web Push subscription for a public CLIENT (anonymous — no login), scoped to a
/// single booking. Lets us notify the customer's device about that booking's
/// status changes (confirmed/rescheduled/cancelled) and reminders. Deleted with
/// the booking. Distinct from PushSubscription (which is for backoffice staff).
model ClientPushSubscription {
  id        String   @id
  bookingId String
  /// Push service endpoint URL (unique per browser/device subscription).
  endpoint  String   @unique
  /// Encryption keys from the browser PushSubscription (for payload encryption).
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("client_push_subscriptions")
}

/// Hashed, rotatable refresh tokens. Enables logout + revoke-on-rotation.
model RefreshToken {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Platform (internal-backoffice) ──────────────────────────

/// Platform staff role. `owner` can manage other platform staff; `operator`
/// can provision/manage partners but not other platform accounts.
enum PlatformRole {
  owner
  operator
}

/// Internal-backoffice operator. NOT tied to a partner — this is Reserva's own
/// staff who provision and manage partner tenants. Kept entirely separate from
/// the tenant `User` table so platform and tenant auth never cross over.
model PlatformUser {
  id    String       @id
  name  String
  email String       @unique
  role  PlatformRole @default(operator)

  passwordHash       String
  mustChangePassword Boolean @default(false)

  active    Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens PlatformRefreshToken[]

  @@index([active])
  @@map("platform_users")
}

/// Hashed, rotatable refresh tokens for platform sessions.
model PlatformRefreshToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_refresh_tokens")
}

// ── Self-serve signup (public) ──────────────────────────────

/// A pending self-serve signup, created when someone starts a free trial on the
/// marketing site. Holds the partner + admin details and a hashed magic-link
/// token. On activation (link click) we create the real Partner + admin User
/// atomically and delete/mark this row. Not yet a real tenant.
model PendingRegistration {
  id        String  @id
  /// Hashed activation token (the raw token goes only in the emailed link).
  tokenHash String  @unique

  // Partner details
  companyName String
  companyType String
  slug        String
  accent      String
  kind        PartnerKind @default(salon)

  // Admin details
  adminName    String
  adminEmail   String
  adminPhone   String
  passwordHash String

  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  // Uniqueness is enforced at creation against partners/users; these help
  // dedupe repeated signups from the same email/slug.
  @@index([adminEmail])
  @@index([slug])
  @@map("pending_registrations")
}

// ── Demo requests (public "Book a demo" form → internal console) ──

enum DemoRequestStatus {
  new
  done
}

/// A lead from the public landing "Book a demo" form. No auth — anyone can
/// submit; platform staff triage them in the internal console (mark done).
model DemoRequest {
  id        String            @id
  name      String
  company   String?
  phone     String?
  email     String?
  notes     String?
  status    DemoRequestStatus @default(new)
  /// Platform user who marked it handled (light audit trail).
  handledBy String?
  handledAt DateTime?
  createdAt DateTime          @default(now())

  @@index([status, createdAt])
  @@map("demo_requests")
}

/// One row per page view on the public site (reserva.am). Written by the public
/// /public/visits endpoint; enrichment fields are derived server-side from the
/// request IP (geoip-lite) and User-Agent (ua-parser-js), so all are nullable.
model VisitorEvent {
  id         String   @id
  ip         String?
  userAgent  String?
  // Parsed from the User-Agent.
  deviceType String? // mobile | tablet | desktop | console | smarttv | wearable | embedded
  browser    String?
  browserVer String?
  os         String?
  osVer      String?
  // Page context sent by the client.
  path       String?
  host       String?
  referrer   String?
  language   String?
  screenW    Int?
  screenH    Int?
  // Derived from the IP.
  country    String?
  city       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("visitor_events")
}
