// ─────────────────────────────────────────────────────────────
// Reserva — multi-tenant salon booking platform
// Postgres schema. Tenancy: every owned row carries partnerId.
// IDs are app-generated UUIDv7 (time-ordered, index-friendly).
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────

enum UserRole {
  admin
  manager
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  noshow
}

/// How a booking entered the system — useful for analytics + audit.
enum BookingSource {
  public // client booked themselves via /p/:slug
  backoffice // created by an admin/manager
}

enum OtpChannel {
  phone
  email
}

enum Weekday {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

/// Whether the tenant is a multi-person salon or a solo professional. Drives
/// presentation only (a `single` has one hidden location + specialist under the
/// hood); the booking engine is identical for both.
enum PartnerKind {
  salon
  single
}

/// Which public booking-page layout a partner renders. Presentation-only: the
/// booking API + flow are identical across templates; only the arrangement and
/// chrome differ. `classic` is the original single-scroll page (the default all
/// partners get); `tabbed` groups content under a sticky tab bar.
enum PartnerTemplate {
  classic
  tabbed
}

/// What the floating action button (web bubble + mobile FAB) does in the
/// partner's backoffice. `support` = open the support chat (default), `book` =
/// open the new-booking flow, `hidden` = no FAB at all.
enum SupportWidgetMode {
  support
  book
  hidden
}

/// How a service is priced: a single exact amount, or a min–max range whose
/// exact charge is captured per booking on completion.
enum ServicePriceType {
  fixed
  range
}

/// Difficulty level of a course, shown as a badge on the public card. Optional
/// on the course (null = not specified).
enum CourseLevel {
  beginner
  intermediate
  advanced
}

/// How a course's price is presented publicly.
/// - hidden: no price shown at all (e.g. "contact us" pricing)
/// - free:   shown as "Free" (price is forced to 0)
/// - paid:   shows the `price` amount (price must be > 0)
enum CoursePriceMode {
  hidden
  free
  paid
}

/// Lifecycle of one course run (a "cohort"). draft → open (accepting members) →
/// running (started) → completed (finished) → archived (read-only history). A
/// course always has exactly one non-archived "current" run at a time.
enum CohortStatus {
  draft
  open
  running
  completed
  archived
}

/// Whether a course member was added by staff or self-registered from the
/// public page — mirrors BookingSource for symmetry/analytics.
enum EnrollmentSource {
  public // member registered themselves via /p/:slug
  backoffice // added by an admin/manager
}

/// State of a single course member. Self-registrations land as `pending` and
/// staff confirm; manual adds are `confirmed` immediately. Terminal states
/// mirror BookingStatus so the two domains read alike.
enum EnrollmentStatus {
  pending
  confirmed
  cancelled
  completed
  noshow
}

// ── Partner (tenant) ────────────────────────────────────────

model Partner {
  id       String  @id
  /// Public URL handle: slug.reserva.am / reserva.am/p/:slug. Optional — a
  /// partner can be created without one (then the public page 404s until the
  /// owner sets a slug in Settings). Unique when present (Postgres allows
  /// multiple NULLs under a unique index).
  slug     String? @unique
  name     String
  /// Optional per-language overrides for `name`, shape { hy?, en?, ru? }. Null /
  /// missing locale → falls back to `name` (the base value stays source of
  /// truth for search/sort/emails). Additive: existing rows keep behaving as today.
  nameI18n Json?
  /// Free-text category shown publicly, e.g. "Aesthetic clinic".
  type     String
  /// Optional per-language overrides for `type` (the public category chip),
  /// shape { hy?, en?, ru? }. Null / missing locale → falls back to `type`.
  /// Additive: existing rows keep behaving as today.
  typeI18n Json?

  /// salon (default) or single (solo professional). Presentation-only flag.
  kind PartnerKind @default(salon)

  /// Public booking-page layout. Presentation-only (API/flow unchanged across
  /// templates). Defaults to the original `classic` page for every partner.
  template PartnerTemplate @default(classic)

  /// Backoffice floating action button behavior (support chat / new booking /
  /// hidden). Set by the partner; overridable by platform staff. Default support.
  supportWidget SupportWidgetMode @default(support)

  /// Default language for the PUBLIC client page (slug.reserva.am) shown to
  /// first-time visitors. One of the client locales ('hy' | 'en' | 'ru').
  /// A visitor's own saved language choice always wins over this. Presentation-
  /// only; defaults to Armenian (our primary market).
  defaultLocale String @default("hy")

  // Branding
  accent String // primary brand color (hex)

  /// When false (default), public bookings land as `pending` and staff must
  /// confirm them manually. When true, public bookings are auto-confirmed.
  autoConfirmBookings Boolean @default(false)

  /// When true (default), the public page (/p/:slug) shows booking CTAs and the
  /// booking flow works. When false, the salon is "contact-only": all booking
  /// CTAs are hidden/replaced with call/contact actions and the public booking
  /// endpoints reject. Togglable by the partner (Settings) and platform staff.
  bookingsEnabled Boolean @default(true)

  /// Whether this salon is featured in the public Reserva marketplace (/salons).
  /// Curated: only togglable from the internal-backoffice (platform staff). The
  /// partner sees it read-only. Default off — salons opt in via the platform.
  marketplaceListed Boolean @default(false)

  /// Whether the Courses (academy) feature is enabled for this partner. An opt-in
  /// premium capability toggled ONLY from the internal-backoffice (platform staff);
  /// when false the Courses nav (backoffice) and the public Courses section are
  /// hidden and public registration is rejected. Default off.
  coursesEnabled Boolean @default(false)

  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  presentation      PartnerPresentation?
  locations         Location[]
  services          Service[]
  specialists       Specialist[]
  bookings          Booking[]
  clients           Client[]
  users             User[]
  courses           Course[]
  courseCohorts     CourseCohort[]
  courseEnrollments CourseEnrollment[]
  supportThread     SupportThread?
  vacancies         Vacancy[]
  products          PartnerProduct[]

  @@index([active])
  // Marketplace listing query: active, listed salons.
  @@index([marketplaceListed, active])
  @@map("partners")
}

// ── Products (ecosystem entitlements) ───────────────────────
// Reserva is several products sharing one Partner (booking, courses, and later
// vacancies / seminars). Which products an organization may use is a row per
// partner × product rather than a boolean column per product, so a grant can
// carry its own lifecycle — status, plan, trial window, who turned it on — and
// so adding a product never means adding a column.
//
// NOTE the distinction from `Partner.bookingsEnabled`: that is a SETTING inside
// the booking product ("contact-only mode", toggled by the partner themselves),
// not an entitlement. `Partner.coursesEnabled` IS an entitlement (staff-granted)
// and is mirrored here.

/// Catalog of products in the ecosystem. Seeded, and extended by INSERT rather
/// than by migration — adding `vacancies` is a row, not a schema change.
model Product {
  /// Stable machine key used in code, guards and API payloads (e.g. 'booking').
  key         String @id
  name        String
  description String @default("")

  /// Whether a partner may take this product on themselves (signup / settings).
  /// Curated products stay false and are granted by platform staff only.
  selfServe Boolean @default(false)

  /// Display order in navigation and product switchers.
  sortOrder Int     @default(0)
  /// Lets a product be built and seeded before it is offered to anyone.
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants PartnerProduct[]

  @@map("products")
}

/// Lifecycle of a single partner's access to a single product.
enum PartnerProductStatus {
  active
  trialing
  /// Retained (settings and history intact) but access is refused.
  suspended
}

/// One organization's grant of one product.
model PartnerProduct {
  id         String @id
  partnerId  String
  productKey String

  status      PartnerProductStatus @default(active)
  /// Tier within the product; null = default tier.
  plan        String?
  trialEndsAt DateTime?

  /// Per-product configuration, so a new product adds no columns to Partner.
  settings Json @default("{}")

  /// Audit — the platform/partner user who granted it. Null for automated
  /// grants (signup, backfill).
  enabledById String?
  enabledAt   DateTime  @default(now())
  /// Set when access is withdrawn; the row is kept so history and settings
  /// survive a later re-enable.
  disabledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// Restrict: a product still granted to someone must not vanish from the catalog.
  product Product @relation(fields: [productKey], references: [key], onDelete: Restrict)

  @@unique([partnerId, productKey])
  // "Which partners use vacancies?" — the internal console's core query.
  @@index([productKey, status])
  @@map("partner_products")
}

// ── Area taxonomy (platform catalog) ────────────────────────

/// How deep an area sits. Armenia is `region` (marz) -> `city` -> `district`,
/// but the depth genuinely varies — Yerevan has 12 districts, Gyumri has none —
/// which is why this is one self-referencing tree rather than a fixed pair of
/// tables like SpecialtyGroup/Specialty.
enum AreaKind {
  region
  city
  district
}

/// A place a branch can be in: "Yerevan", "Yerevan / Arabkir", "Gyumri".
///
/// Platform-owned like Specialty — partners pick from it, never edit it — and
/// for the same reason: a filter is only useful if every partner in the country
/// tags the same place with the same key. Free-text addresses cannot do that
/// (transliteration, typos, and most addresses name no district at all).
model Area {
  key       String   @id
  /// Parent in the tree; null for a top-level region or city.
  parentKey String?
  kind      AreaKind

  /// English name — source of truth for search and sort.
  name     String
  /// Required { hy, ru }. Not an override blob: a place with no Armenian name is
  /// unusable in the Armenian UI, so it is data rather than a fallback.
  nameI18n Json

  /// Search-only synonyms across languages AND eras, lowercased. This is where
  /// the names people actually type live: Soviet-era ("leninakan", "кировакан"),
  /// colloquial ("ejmiatsin" for Vagharshapat, "masiv" for the Ajapnyak blocks),
  /// and transliteration variants ("erevan", "ереван"). Never rendered.
  aliases String[] @default([])

  /// Centroid, for centring a map and for distance sorting later. Optional
  /// because a region has no meaningful single point.
  lat Float?
  lng Float?

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Restrict: an area in use must not vanish and strand branches with a
  /// dangling key — the same rule as Product and Specialty.
  parent    Area?      @relation("AreaTree", fields: [parentKey], references: [key], onDelete: Restrict)
  children  Area[]     @relation("AreaTree")
  locations Location[]

  @@index([parentKey, sortOrder])
  @@index([active, kind, sortOrder])
  @@map("areas")
}

// ── Specialty taxonomy (platform catalog) ───────────────────

/// Top-level bucket for specialties ("Hair", "Nails", "Medical"). Exists so the
/// console and the public filters can group ~50 specialties into something a
/// human can scan. Platform-owned: partners pick from it, never edit it.
model SpecialtyGroup {
  key      String @id
  /// English name — the source of truth for search/sort.
  name     String
  /// Per-language names, shape { hy, ru }. Unlike partner-authored content
  /// (where i18n is an optional override), a platform catalog is rendered to
  /// every user in their own language, so translations are NOT optional here.
  nameI18n Json

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specialties Specialty[]

  @@index([active, sortOrder])
  @@map("specialty_groups")
}

/// One field of work, carrying BOTH names it is known by:
///   `name`     — the craft        ("Hair styling") -> service categories, filters
///   `roleName` — the practitioner ("Hair stylist") -> vacancies, specialist titles
/// One row therefore serves every product without the vocabulary being retyped
/// per partner, which is what makes cross-product search possible at all.
model Specialty {
  key      String @id
  groupKey String

  name         String
  nameI18n     Json
  roleName     String
  roleNameI18n Json

  /// Search-only synonyms across every language, lowercased ("hairdresser",
  /// "парикмахер", "վարսահարդար"). Never rendered — they exist so someone
  /// typing the word they know lands on the right row.
  aliases String[] @default([])

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Restrict: a specialty in use must not vanish from the catalog and orphan
  /// live listings — the same rule as Product <- PartnerProduct.
  group     SpecialtyGroup @relation(fields: [groupKey], references: [key], onDelete: Restrict)
  vacancies Vacancy[]

  @@index([groupKey, sortOrder])
  @@index([active, sortOrder])
  @@map("specialties")
}

/// Public-facing marketing fields for the branded booking page. Split from
/// Partner so the hot tenant row stays lean and these rarely-changing,
/// publicly-served fields can be cached/served independently.
model PartnerPresentation {
  partnerId   String  @id
  tagline     String  @default("")
  /// Optional per-language overrides for `tagline`, shape { hy?, en?, ru? }.
  taglineI18n Json?
  about       String  @default("")
  /// Optional per-language overrides for `about` (same shape/fallback rules).
  aboutI18n   Json?
  /// Optional brand logo URL. Shown instead of the name initial where set.
  logoUrl     String  @default("")
  hours       String  @default("") // human-readable summary, e.g. "Mon–Sat · 10:00–19:00"
  /// Public social links (full URLs). Empty = not shown on the booking page.
  instagram   String  @default("")
  facebook    String  @default("")
  /// WhatsApp number in international digits (e.g. "37491234567"), used to build
  /// a wa.me click-to-chat link on the public page. Empty = not shown.
  whatsapp    String  @default("")
  rating      Decimal @default(0) @db.Decimal(2, 1)
  reviews     Int     @default(0)
  /// Hero gradient tints [from, to] + decorative gallery tiles, stored as JSON
  /// since they're presentation-only and read as a blob.
  heroTints   Json    @default("[]")
  /// "Inside" gallery — simple photos of the place. JSON array of tiles.
  gallery     Json    @default("[]")
  /// "Works" — photos of the work done; tiles may be simple or before/after.
  works       Json    @default("[]")

  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_presentations")
}

// ── Location (branch) ───────────────────────────────────────

model Location {
  id        String @id
  partnerId String
  name      String
  /// Optional per-language overrides for `name`, shape { hy?, en?, ru? }. Null /
  /// missing locale → falls back to `name` (the base value stays source of
  /// truth for search/sort). Additive: existing rows keep behaving as today.
  /// Only the branch NAME is translatable — address/geo stays single-value.
  nameI18n  Json?
  address   String
  phone     String @default("")

  /// Structured place, for filtering and facets. NULLABLE on purpose: existing
  /// branches predate this column and must keep working. It is required at the
  /// product boundary instead — a vacancy cannot be published from a branch with
  /// no area, because that is a listing the board cannot place. The free-text
  /// `address` stays as the human-readable street line; the two are
  /// complementary, not alternatives.
  areaKey String?

  /// Geo coordinates from the map picker (null until set). Powers map display,
  /// directions, and future "near me" / distance sort on the marketplace.
  lat Float?
  lng Float?

  /// Weekly opening hours: { mon: { enabled, start, end }, ... }. JSON because
  /// it's always read/written as a whole and never queried by inner fields.
  hours Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partner       Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  specialists   Specialist[]
  bookings      Booking[]
  users         User[]
  courseCohorts CourseCohort[]
  vacancies     Vacancy[]
  /// Restrict, not SetNull: deleting an area that branches sit in would silently
  /// strip their place and leave any published vacancy unplaceable. Staff
  /// deactivate an area instead — same rule as Product and Specialty.
  area          Area?          @relation(fields: [areaKey], references: [key], onDelete: Restrict)

  @@index([partnerId, deletedAt])
  /// "which branches are in this area" — the board's filter path.
  @@index([areaKey])
  @@map("locations")
}

// ── Service ─────────────────────────────────────────────────

model Service {
  id              String           @id
  partnerId       String
  name            String
  /// Optional per-language overrides for `name`, shape { hy?, en?, ru? }. Null /
  /// missing locale → falls back to `name` (the base value stays source of
  /// truth for search/sort). Additive: existing rows keep behaving as today.
  nameI18n        Json?
  category        String           @default("")
  /// Optional per-language overrides for `category` (same shape/fallback rules).
  categoryI18n    Json?
  /// Whether `price` is an exact amount or the low end of a range. A `range`
  /// service quotes `price`–`priceMax` publicly, and its exact charge is captured
  /// per booking on completion (Booking.finalPrice).
  priceType       ServicePriceType @default(fixed)
  /// Stored in the smallest currency unit (AMD has no minor unit → whole drams).
  /// For a range service this is the LOWER bound (kept as `price` so existing
  /// reads treat it as a sensible baseline).
  price           Int
  /// Upper bound for a range service; null for fixed-price services.
  priceMax        Int?
  /// Duration in minutes.
  duration        Int
  /// How often this service should be repeated, in TOTAL DAYS (e.g. 40 = "1
  /// month & 10 days"). Null = no recurrence. Foundation for future "time to
  /// rebook" reminders. Backoffice-only; never shown on the public page.
  repeatEveryDays Int?

  /// When false, this is a "facility"/entry service (spa sauna, pool, day pass)
  /// that isn't tied to a person — availability comes from location hours and
  /// `capacity` concurrent guests, and booking skips specialist selection.
  requiresSpecialist Boolean @default(true)
  /// Max concurrent bookings per time slot for a no-specialist service. Ignored
  /// when requiresSpecialist = true.
  capacity           Int     @default(1)

  active Boolean @default(true)

  /// Manual display order (0-based) within a partner's service list. Drives both
  /// the backoffice list and the public page so they always agree. Set by the
  /// partner via drag-to-reorder; new services append to the end. Lower = first.
  sortOrder Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partner         Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  specialistLinks SpecialistService[]
  bookings        Booking[]

  @@index([partnerId, deletedAt])
  @@index([partnerId, active])
  @@index([partnerId, sortOrder])
  @@map("services")
}

// ── Course ──────────────────────────────────────────────────
// A salon "academy" offering (e.g. a hair-styling course). Two-level model:
//   Course  — the reusable template (title, cover, price, tutor).
//   CourseCohort — one actual RUN of it (dates, capacity, members, status).
//   CourseEnrollment — a member of a run. Self-contained (name/phone stored
//     inline); a course member is NOT a booking Client — the two domains are
//     kept fully separate on purpose.

model Course {
  id        String @id
  partnerId String

  /// Course title (base value = source of truth for search/sort).
  title           String
  /// Optional per-language overrides for `title`, shape { hy?, en?, ru? }.
  titleI18n       Json?
  /// One-line teaser shown on the public card.
  summary         String @default("")
  /// Optional per-language overrides for `summary`.
  summaryI18n     Json?
  /// Long-form description / curriculum (what you'll learn).
  description     String @default("")
  /// Optional per-language overrides for `description`.
  descriptionI18n Json?

  /// Cover image URL (WebP under <uploads>/<partnerId>/). Empty = gradient placeholder.
  coverUrl String @default("")

  /// How the price is presented publicly (see CoursePriceMode). `paid` shows
  /// `price`; `free` shows "Free"; `hidden` shows nothing. Defaults to `paid`
  /// so existing rows with a price keep showing it (the migration sets rows
  /// with price 0 to `free`, matching the old "0 = free" convention).
  priceMode CoursePriceMode @default(paid)
  /// Price in the smallest currency unit (whole AMD). Only meaningful when
  /// priceMode = paid; forced to 0 for free/hidden.
  price     Int             @default(0)

  /// Optional tutor. EITHER a link to one of the salon's specialists (reuses
  /// their name/photo) OR free-text for a guest instructor — never both required.
  tutorSpecialistId String?
  tutorName         String  @default("")
  tutorTitle        String  @default("")

  /// Optional difficulty badge.
  level CourseLevel?

  /// Public visibility. When false the course is a draft (hidden from /p/:slug).
  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partner         Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// Tutor link is optional and must not orphan on specialist delete → SetNull.
  tutorSpecialist Specialist?    @relation("CourseTutor", fields: [tutorSpecialistId], references: [id], onDelete: SetNull)
  cohorts         CourseCohort[]

  @@index([partnerId, deletedAt])
  @@index([partnerId, active])
  @@map("courses")
}

/// One run of a course. A course always has exactly one non-archived "current"
/// cohort; "start a new run" archives the old one and creates a fresh one.
model CourseCohort {
  id        String @id
  courseId  String
  partnerId String // denormalized for fast tenant-scoped queries

  /// Optional branch this run happens at.
  locationId String?

  /// Optional fixed dates (group courses). Null = rolling/undated.
  startDate    DateTime?
  endDate      DateTime?
  /// Free-text schedule, e.g. "Tue & Thu · 18:00–20:00". Schedules are irregular
  /// enough that structured slots aren't worth it here.
  scheduleText String    @default("")

  /// Max confirmed members. 0 = unlimited.
  capacity         Int          @default(0)
  status           CohortStatus @default(open)
  /// Whether self-registration from the public page is accepted for this run.
  registrationOpen Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  partner     Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  location    Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  enrollments CourseEnrollment[]

  @@index([courseId, deletedAt])
  @@index([partnerId, status])
  @@map("course_cohorts")
}

/// A member of a course run. Self-contained: the member's contact is stored
/// inline (NOT linked to the booking Client table) — course students live in
/// their own world, separate from appointment clients.
model CourseEnrollment {
  id        String @id
  cohortId  String
  partnerId String // denormalized for fast tenant-scoped queries

  /// Member contact — stored directly on the enrollment.
  memberName  String
  memberPhone String
  memberEmail String @default("")

  status EnrollmentStatus @default(pending)
  source EnrollmentSource @default(backoffice)
  notes  String?

  /// Price captured at enrollment time (course price may change later).
  priceAtEnroll Int     @default(0)
  /// UI language the member registered in ('en' | 'hy' | 'ru'); null for staff adds.
  locale        String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cohort  CourseCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  partner Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  /// One active enrollment per phone per run. (A cancelled member re-registering
  /// is handled by reactivating the existing row, not inserting a duplicate.)
  @@unique([cohortId, memberPhone])
  @@index([partnerId, status])
  @@index([cohortId, status])
  @@map("course_enrollments")
}

// ── Vacancies ───────────────────────────────────────────────

/// How a position pays. This industry runs on three arrangements that are
/// structurally different relationships, not variations of a salary:
///  - percentage: the salon keeps a share of what the master earns
///  - rent:       the master pays the salon a fixed amount for a "chair", so
///                the money flows the OTHER way round
///  - salary:     ordinary employment
///  - negotiable: real terms exist but are not published ("by agreement"),
///                which is a stated position here rather than a blank field
enum VacancyPayType {
  percentage
  rent
  salary
  negotiable
}

/// Billing period for `amount` — chair rent is sometimes daily, salary monthly.
enum VacancyPayPeriod {
  day
  week
  month
}

enum VacancyScheduleType {
  full_time
  part_time
  shift
  flexible
}

/// Deliberately coarse: real listings say "with experience", never "3 years".
enum VacancyExperience {
  any
  junior
  experienced
}

/// How candidates reach the salon. `phone` matters as much as `in_app` — most
/// hiring in this market still starts with a call, and a listing that can only
/// be answered in-app is a listing many salons simply will not post.
enum VacancyApplyMode {
  in_app
  phone
  both
}

/// draft -> published <-> paused -> closed. `expired` is set when `expiresAt`
/// passes, so the board never quietly advertises positions already filled.
enum VacancyStatus {
  draft
  published
  paused
  closed
  expired
}

/// Platform moderation. Everything is approved on create today; the column
/// exists from day one because retrofitting moderation onto a live public board
/// means backfilling thousands of undecided rows.
enum VacancyReviewStatus {
  pending
  approved
  rejected
}

model Vacancy {
  id         String @id
  partnerId  String
  /// Non-null on purpose: a position with no address cannot be listed, filtered
  /// by city or put on a map. Location is organization-level (already shared by
  /// bookings and courses), so this holds even for a partner whose ONLY product
  /// is vacancies.
  locationId String

  specialtyKey String
  /// Listing headline. Required when specialtyKey = 'other'; otherwise optional
  /// and falls back to the specialty's localized role name.
  title        String @default("")
  titleI18n    Json?

  description     String @default("")
  descriptionI18n Json?

  /// Optional cover image (WebP under <uploads>/<partnerId>/). Empty = gradient.
  coverUrl String @default("")
  /// How many people are wanted — stops the same listing being posted twice.
  seats    Int    @default(1)

  // ── Terms ──
  payType         VacancyPayType   @default(negotiable)
  /// The share the SALON keeps, 0-100. Named for the salon rather than the
  /// master so "60/40" can never be read the wrong way round anywhere.
  salonPercent    Int?
  /// Upper bound when the split depends on experience ("40-50%").
  salonPercentMax Int?
  /// Whole AMD (no minor unit), same convention as Service.price. Rent OR salary.
  amount          Int?
  amountMax       Int?
  payPeriod       VacancyPayPeriod @default(month)
  currency        String           @default("AMD")

  // ── The work ──
  scheduleType VacancyScheduleType?
  scheduleNote String               @default("")
  experience   VacancyExperience    @default(any)
  /// Perk keys from the shared vocabulary ("materials-included",
  /// "own-client-base"). A key list keeps them translatable and filterable
  /// without a join table for something only ever read as a whole.
  perks        String[]             @default([])

  // ── Contact ──
  applyMode    VacancyApplyMode @default(both)
  contactPhone String           @default("")

  // ── Lifecycle ──
  status       VacancyStatus       @default(draft)
  reviewStatus VacancyReviewStatus @default(approved)
  publishedAt  DateTime?
  /// Listings auto-expire so the board never shows filled positions; renewed
  /// with one click from the backoffice.
  expiresAt    DateTime?
  closedAt     DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Soft delete, matching Location/Service/Specialist — removing a listing must
  /// not erase the record that someone applied to it.
  deletedAt   DateTime?

  partner      Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// Restrict: deleting a branch that still advertises positions would strand
  /// them with no address.
  location     Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  specialty    Specialty            @relation(fields: [specialtyKey], references: [key], onDelete: Restrict)
  /// People who applied. Cascades on a HARD delete only — a listing is soft
  /// deleted, so removing it from the board keeps its applicants readable.
  applications VacancyApplication[]

  /// The backoffice list — this partner's listings by state.
  @@index([partnerId, deletedAt, status])
  /// The public board — "published colorist positions", newest first.
  @@index([status, deletedAt, publishedAt])
  @@index([specialtyKey, status])
  @@index([locationId])
  @@map("vacancies")
}

/// Where an application came from. Only `board` is produced today; the column
/// exists now so that shipping professional accounts is an INSERT of a new
/// value rather than a backfill of thousands of undecided rows.
enum VacancyApplicationSource {
  board
  account
}

/// How the salon has triaged one applicant.
///
/// Deliberately tiny. A salon works this list with a phone in its hand, so the
/// only states worth storing are "nobody has looked yet", "we called them",
/// "we want them" and "no".
enum VacancyApplicationStatus {
  new
  contacted
  shortlisted
  rejected
}

/// One person applying to one listing.
///
/// There is no account to point at: applications are unauthenticated today, so
/// this row IS the applicant. When professional registration ships, a nullable
/// `userId` joins the two without touching what is stored here.
model VacancyApplication {
  id        String @id
  vacancyId String

  /// As the applicant typed it.
  name  String
  /// Normalized to E.164 (`normalizePhone`) so the unique constraint below
  /// treats "+374 93 813296" and "+37493813296" as the same person.
  phone String
  email String @default("")
  /// Their message to the salon — the free text that actually gets read.
  note  String @default("")

  /// UI language the person applied in, so the salon calls back in it.
  locale String                   @default("hy")
  source VacancyApplicationSource @default(board)

  status    VacancyApplicationStatus @default(new)
  /// First time the salon opened it — what makes the "new" badge trustworthy.
  seenAt    DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  /// One application per person per listing. Re-applying updates their message
  /// instead of filling the salon's inbox with duplicates.
  @@unique([vacancyId, phone])
  /// The salon's inbox for one listing, newest first.
  @@index([vacancyId, createdAt])
  @@map("vacancy_applications")
}

// ── Specialist ──────────────────────────────────────────────

model Specialist {
  id         String  @id
  partnerId  String
  locationId String
  name       String
  /// Optional per-language overrides for `name` (transliteration), shape { hy?, en?, ru? }.
  nameI18n   Json?
  title      String  @default("")
  /// Optional per-language overrides for `title` (role), shape { hy?, en?, ru? }.
  titleI18n  Json?
  phone      String  @default("")
  active     Boolean @default(true)
  /// Optional profile photo URL. Shown instead of the name-initial avatar where
  /// set (public team card, specialist modal, booking picker). Empty = initials.
  avatarUrl  String  @default("")

  /// Recurring weekly schedule: { mon: { enabled, start, end }, ... }.
  schedule Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partner        Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  location       Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  services       SpecialistService[]
  timeOff        SpecialistTimeOff[]
  bookings       Booking[]
  reviews        SpecialistReview[]
  /// Courses where this specialist is credited as the tutor (optional link).
  tutoredCourses Course[]            @relation("CourseTutor")

  @@index([partnerId, deletedAt])
  @@index([locationId, active])
  @@map("specialists")
}

/// Public review left for a specialist on the booking page. No auth — the
/// reviewer optionally gives a name (else shown as "Anonymous"); stars are
/// required, text is optional. Published instantly; partners delete unwanted
/// ones from the backoffice. Ratings shown in the client app are computed
/// averages of these rows (never fabricated).
model SpecialistReview {
  id           String @id
  specialistId String
  partnerId    String // denormalized for fast tenant-scoped queries
  /// Reviewer's display name; empty → rendered as "Anonymous".
  author       String @default("")
  /// 1–5 stars (enforced in the DTO).
  rating       Int
  /// Optional free-text comment.
  text         String @default("")

  createdAt DateTime @default(now())

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([specialistId, createdAt])
  @@index([partnerId, createdAt])
  @@map("specialist_reviews")
}

/// Join table: which services a specialist can perform (many-to-many).
model SpecialistService {
  specialistId String
  serviceId    String

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([specialistId, serviceId])
  @@index([serviceId])
  @@map("specialist_services")
}

/// One-off, dated unavailability that overrides the weekly schedule.
model SpecialistTimeOff {
  id           String   @id
  specialistId String
  partnerId    String // denormalized for fast tenant-scoped queries
  startAt      DateTime
  endAt        DateTime
  allDay       Boolean  @default(false)
  reason       String?
  createdById  String?

  createdAt DateTime @default(now())

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([specialistId, startAt, endAt])
  @@index([partnerId, startAt])
  @@map("specialist_time_off")
}

// ── Client ──────────────────────────────────────────────────

/// A customer of a partner. No client-facing auth — created/updated implicitly
/// when a booking is made (deduped per partner on normalized phone). Powers the
/// backoffice Clients page.
model Client {
  id        String  @id
  partnerId String
  name      String
  /// Normalized (digits-only) phone — the per-partner identity key.
  phone     String
  email     String?
  notes     String?

  /// Telegram chat id, set once the customer connects via @ReservaBookingBot
  /// (deep-link /start flow). When present, booking notifications are delivered
  /// to them for free over Telegram. Null = not connected.
  telegramChatId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner       Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  telegramLinks TelegramLink[]

  @@unique([partnerId, phone])
  @@index([partnerId, name])
  @@map("clients")
}

/// Short-lived, single-use token that binds a Telegram chat to a Client. Created
/// when we show the "Get notified" button after a booking; consumed when the
/// customer presses Start on the bot (the token rides in the /start payload).
model TelegramLink {
  /// The opaque token embedded in the t.me/<bot>?start=<token> deep link.
  token      String    @id
  clientId   String
  /// The booking this link was generated from (for the welcome message context).
  bookingId  String?
  expiresAt  DateTime
  /// Set when the customer completes the /start bind — makes the token single-use.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
  @@map("telegram_links")
}

// ── Booking ─────────────────────────────────────────────────

model Booking {
  id           String  @id
  partnerId    String
  locationId   String
  /// Null for facility/entry services that aren't tied to a person (spa).
  specialistId String?
  serviceId    String
  /// The CRM client this booking belongs to. NULL for a walk-in entered from the
  /// backoffice without a phone number: phone is the per-partner client identity
  /// key (`Client.@@unique([partnerId, phone])`), so a booking with no phone has
  /// no client row to point at. Public bookings always require a phone and are
  /// therefore always linked.
  clientId     String?

  /// Snapshot of client contact at time of booking (client row may change).
  clientName  String
  /// Empty string when a staff member booked a walk-in without a phone number.
  clientPhone String

  startAt DateTime
  endAt   DateTime
  status  BookingStatus @default(confirmed)
  source  BookingSource @default(backoffice)
  notes   String?

  /// UI language the customer booked in ('en' | 'hy' | 'ru'). Used to localize
  /// reminder/confirmation messages later. Null for older/backoffice bookings.
  locale String?

  /// Price captured at booking time (service price may change later). For a
  /// range service this is the range's LOWER bound at booking time.
  priceAtBooking    Int  @default(0)
  /// Upper bound captured at booking time for a range service; null for fixed.
  priceMaxAtBooking Int?
  /// Exact amount charged, entered when a range-priced booking is completed.
  /// Null for fixed-price bookings (their price is exact) or until captured.
  /// Revenue uses `finalPrice ?? priceAtBooking`.
  finalPrice        Int?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner           Partner                  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  location          Location                 @relation(fields: [locationId], references: [id], onDelete: Restrict)
  specialist        Specialist?              @relation(fields: [specialistId], references: [id], onDelete: Restrict)
  service           Service                  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  client            Client?                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  pushSubscriptions ClientPushSubscription[]

  // Calendar/list queries are almost always tenant + time-window scoped.
  @@index([partnerId, startAt])
  @@index([locationId, startAt])
  @@index([specialistId, startAt])
  @@index([clientId, startAt])
  @@index([partnerId, status, startAt])
  @@map("bookings")
}

// ── User (backoffice staff) ─────────────────────────────────

model User {
  id         String   @id
  partnerId  String
  name       String
  email      String
  phone      String
  role       UserRole @default(manager)
  /// Managers are scoped to a single branch; admins have null (all locations).
  locationId String?

  passwordHash       String
  /// Force a password change after first login (managers created with an OTP).
  mustChangePassword Boolean     @default(false)
  otpChannel         OtpChannel?

  active     Boolean   @default(true)
  lastLogin  DateTime?
  /// Last time this user was active in the backoffice (bumped on app load /
  /// refresh via /auth/me, throttled). Reflects real usage, not just logins.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  partner           Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  // Login is by email OR phone, globally unique so the right tenant is found.
  @@unique([email])
  @@unique([phone])
  @@index([partnerId, role])
  @@map("users")
}

/// Booking-related event types that produce notifications.
enum NotificationType {
  booking_created
  booking_rescheduled
  booking_cancelled
  booking_confirmed
  booking_completed
  booking_noshow
  course_registration
}

/// In-app notification feed — ONE row per recipient user (so read/unread is
/// per-user without a join). Low-volume + prunable. `data` carries render +
/// deep-link info (clientName, service, time, bookingId).
model Notification {
  id        String           @id
  userId    String
  partnerId String
  type      NotificationType
  title     String
  body      String
  /// Structured payload for the UI: { bookingId, clientName, service, ... }.
  data      Json             @default("{}")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "my unread feed, newest first" is the hot query.
  @@index([userId, read, createdAt])
  @@map("notifications")
}

/// Web Push subscriptions (one user may have several — phone, laptop, …). Used
/// to deliver booking notifications to logged-in backoffice staff.
model PushSubscription {
  id        String   @id
  userId    String
  /// Push service endpoint URL (unique per browser/device subscription).
  endpoint  String   @unique
  /// Encryption keys from the browser PushSubscription (for payload encryption).
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Web Push subscription for a public CLIENT (anonymous — no login), scoped to a
/// single booking. Lets us notify the customer's device about that booking's
/// status changes (confirmed/rescheduled/cancelled) and reminders. Deleted with
/// the booking. Distinct from PushSubscription (which is for backoffice staff).
model ClientPushSubscription {
  id        String   @id
  bookingId String
  /// Push service endpoint URL (unique per browser/device subscription).
  endpoint  String   @unique
  /// Encryption keys from the browser PushSubscription (for payload encryption).
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("client_push_subscriptions")
}

/// Hashed, rotatable refresh tokens. Enables logout + revoke-on-rotation.
model RefreshToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Platform (internal-backoffice) ──────────────────────────

/// Platform staff role. `owner` can manage other platform staff; `operator`
/// can provision/manage partners but not other platform accounts.
enum PlatformRole {
  owner
  operator
}

/// Internal-backoffice operator. NOT tied to a partner — this is Reserva's own
/// staff who provision and manage partner tenants. Kept entirely separate from
/// the tenant `User` table so platform and tenant auth never cross over.
model PlatformUser {
  id    String       @id
  name  String
  email String       @unique
  role  PlatformRole @default(operator)

  passwordHash       String
  mustChangePassword Boolean @default(false)

  active    Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens     PlatformRefreshToken[]
  pushSubscriptions PlatformPushSubscription[]

  @@index([active])
  @@map("platform_users")
}

/// Hashed, rotatable refresh tokens for platform sessions.
model PlatformRefreshToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_refresh_tokens")
}

// ── Self-serve signup (public) ──────────────────────────────

/// A pending self-serve signup, created when someone starts a free trial on the
/// marketing site. Holds the partner + admin details and a hashed magic-link
/// token. On activation (link click) we create the real Partner + admin User
/// atomically and delete/mark this row. Not yet a real tenant.
model PendingRegistration {
  id        String @id
  /// Hashed activation token (the raw token goes only in the emailed link).
  tokenHash String @unique

  // Partner details
  companyName String
  companyType String
  slug        String
  accent      String
  kind        PartnerKind @default(salon)

  /// Which product the visitor signed up FOR — set by the entry point they came
  /// through (reserva.am -> bookings, vacancies.reserva.am -> vacancies). Drives
  /// which entitlement is granted on activation and where they land afterwards.
  /// Defaults to `bookings` so existing signup links behave exactly as before.
  product String @default("bookings")

  // Admin details
  adminName    String
  adminEmail   String
  adminPhone   String
  passwordHash String

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  // Uniqueness is enforced at creation against partners/users; these help
  // dedupe repeated signups from the same email/slug.
  @@index([adminEmail])
  @@index([slug])
  @@map("pending_registrations")
}

// ── Demo requests (public "Book a demo" form → internal console) ──

enum DemoRequestStatus {
  new
  done
}

/// A lead from the public landing "Book a demo" form. No auth — anyone can
/// submit; platform staff triage them in the internal console (mark done).
model DemoRequest {
  id        String            @id
  name      String
  company   String?
  phone     String?
  email     String?
  notes     String?
  status    DemoRequestStatus @default(new)
  /// Platform user who marked it handled (light audit trail).
  handledBy String?
  handledAt DateTime?
  createdAt DateTime          @default(now())

  @@index([status, createdAt])
  @@map("demo_requests")
}

/// One row per page view on the public site (reserva.am). Written by the public
/// /public/visits endpoint; enrichment fields are derived server-side from the
/// request IP (geoip-lite) and User-Agent (ua-parser-js), so all are nullable.
model VisitorEvent {
  id          String   @id
  ip          String?
  userAgent   String?
  // Parsed from the User-Agent.
  deviceType  String? // mobile | tablet | desktop | console | smarttv | wearable | embedded
  browser     String?
  browserVer  String?
  os          String?
  osVer       String?
  // Page context sent by the client.
  path        String?
  host        String?
  /// The partner (salon) slug whose public page was viewed, when the visit was
  /// on a tenant page (slug.reserva.am or /p/slug). Null for the marketplace /
  /// apex pages. Lets the console filter views per partner.
  partnerSlug String?
  referrer    String?
  language    String?
  screenW     Int?
  screenH     Int?
  // Derived from the IP.
  country     String?
  city        String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([partnerSlug, createdAt])
  @@map("visitor_events")
}

// ── Support chat (partner ⇄ platform) ─────────────────────────
// A lightweight in-app support conversation between a partner's staff and the
// Reserva platform team. One thread per partner; messages are exchanged live
// over the SupportGateway (WebSocket) and persisted here for history + unread
// badges. Presentation-only relative to the rest of the domain — no booking or
// tenant logic depends on it.

enum SupportThreadStatus {
  open
  closed
}

/// Who wrote a support message.
enum SupportSender {
  partner // a partner's staff user
  platform // Reserva platform staff
}

/// One support conversation, scoped to a single partner (1:1). Unread counters
/// are denormalized so badge queries are a single-row read (no COUNT scans).
model SupportThread {
  id        String              @id
  partnerId String              @unique
  status    SupportThreadStatus @default(open)

  /// Timestamp of the most recent message — drives thread-list ordering.
  lastMessageAt  DateTime @default(now())
  /// Unread counts per side, bumped on send and reset on read.
  partnerUnread  Int      @default(0)
  platformUnread Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner  Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  // Thread list: open threads with platform-unread first, newest activity first.
  @@index([status, lastMessageAt])
  @@map("support_threads")
}

/// A single message in a support thread. `senderUserId` is the tenant User id
/// (partner side) or PlatformUser id (platform side) for display/audit; it is
/// intentionally NOT a FK so a deleted staff account never cascades away chat
/// history.
model SupportMessage {
  id           String        @id
  threadId     String
  senderType   SupportSender
  senderUserId String?
  /// Display name captured at send time (survives user rename/removal).
  senderName   String        @default("")
  body         String
  readAt       DateTime?
  createdAt    DateTime      @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("support_messages")
}

/// Web Push subscription for a PLATFORM staff user (internal-backoffice). Mirrors
/// PushSubscription (which is tenant-User-only) but keyed to a PlatformUser, so
/// platform and tenant push never cross over. Used to notify staff of new
/// partner support messages when the console isn't focused.
model PlatformPushSubscription {
  id        String   @id
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_push_subscriptions")
}
